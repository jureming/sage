#!/usr/bin/env bash

# ============================================================
# remote
# ============================================================
# 이 파일에는 대상 서버에서 실행할 명령어를 자유롭게 작성합니다.
# 작성한 명령은 Salt를 통해 각 대상 서버에서 실행됩니다.
#
# 예:
#   uptime
#   df -h
#   systemctl status 서비스명
#   cat /etc/hostname
#
# 명령 실행 결과(stdout)는 result/<host> 파일에 저장됩니다.
# ============================================================
#
# ============================================================
# 종료코드(exit code) 계약 — 중요
# ============================================================
# 프레임워크는 이 스크립트를 Salt cmd.run_all 로 실행하고, 각 서버의
# *종료코드(retcode)* 로 성공/실패를 판정합니다:
#   retcode == 0                 → result/<host>  (성공, stdout 저장)
#   retcode != 0  또는 stderr 존재 → error/<host>   (실패)
#       실패 사유는  stderr → (없으면) stdout  순으로 error 파일에 저장됩니다.
#       (즉 실패 사유를 echo 로 stdout 에 남겨도 보존됩니다.)
#
# 따라서 이 스크립트(및 여기서 호출하는 deploy-*.sh)는 다음을 지켜야 합니다:
#
# 1) 실패하면 반드시 non-zero 로 종료한다:  exit 1
#
# 2) 스크립트의 최종 종료코드 = '마지막으로 실행된 명령'의 종료코드다.
#    실패 직후 echo(=exit 0) 같은 명령을 두면 실패가 가려진다.
#    핵심 명령은 직후에 rc 를 캡처하고, 로그를 찍은 뒤 그 코드로 종료한다:
#        critical_cmd ...
#        rc=$?
#        [ "$rc" -ne 0 ] && { echo "실패 사유 ..."; exit "$rc"; }
#    또는 if 로 감싼다:
#        if ! critical_cmd ...; then echo "실패 사유 ..."; exit 1; fi
#
# 3) 외부 스크립트를 호출하면 그 종료코드를 전파한다:
#        bash deploy-x.sh "$TAG"; rc=$?; [ "$rc" -ne 0 ] && exit "$rc"
#
# 4) set -e 만으로는 부족할 수 있다(파이프 중간 명령, if/&&/|| 조건,
#    함수 내부 등은 잡지 못함). 권장: 맨 위에  set -euo pipefail
#    + 핵심 명령은 위 2),3) 처럼 명시적으로 검사/exit.
#
# 5) 성공 경로에서 비정상 종료코드를 흘리지 않는다.
#    마지막 명령이 우연히 non-zero(예: grep 0건 매칭 = exit 1)면 성공인데도
#    실패로 분류된다. 마지막을 exit 0 으로 끝내거나 해당 명령을 `|| true` 로 방어한다.
# ============================================================
