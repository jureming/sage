# ------------------------------------------------------------
# 1) cmd.run
# ------------------------------------------------------------
# RUN_SCRIPT 파일 내용을 대상 서버에서 실행
#
# "__RUN_SCRIPT__" 는 salt_apply에서 특수 처리하는 예약값
#
# 사용 예:
#   RUN_SCRIPT="$base_dir/remote"
# ------------------------------------------------------------
SALT_FUNCTION="cmd.run"
SALT_ARGS=("__RUN_SCRIPT__")
RUN_SCRIPT="$base_dir/remote"

# ============================================================
# 실행 옵션
# ============================================================
# SKIP_PING
#         : true 이면 사전 test.ping 검사를 생략
#           false 또는 미설정이면 기존처럼 test.ping 검사 수행
#
# ASYNC
#         : true 이면 salt --async 로 job만 던지고 결과를 기다리지 않음
#           이 경우 post 단계는 실행하지 않음
#           false 또는 미설정이면 결과를 기다리고 post 실행
#
# COLLECT_BY_JID
#         : true 이면 일반 실행도 salt --async 로 JID를 먼저 발급받고,
#           jobs.lookup_jid 로 진행률/결과를 수집합니다.
#           Salt CLI stdout 전체를 실시간 log_salt에 쓰지 않으므로
#           대규모 실행에서 유리합니다.
#
# JOB_WAIT_TIMEOUT
#         : JID 결과를 기다릴 최대 시간(초)
#           0이면 무제한 대기합니다.
#           missing 서버 중 ping 실패/timeout 은 중간 점검에서
#           minion_unreachable 로 제외됩니다.
#           ping OK + find_job 결과 있음은 still_running 으로 보고
#           이 시간 안에서 계속 기다립니다.
#
# JID_CHUNK_SIZE
#         : 최종 server 목록을 지정한 개수만큼 나눠
#           salt --async + jobs.lookup_jid 방식으로 순차 실행합니다.
#           기본적으로 최종 server 목록을 랜덤 셔플한 뒤 분할합니다.
#           비어있거나 0이면 기존처럼 전체 대상을 한 번에 실행합니다.
#           ASYNC=true 또는 COLLECT_BY_JID=false 와는 함께 사용할 수 없습니다.
#
#           예) JID_CHUNK_SIZE="200"
#               - 대상 1500대면 200대씩 총 8회 실행
#               JID_CHUNK_SIZE="" or JID_CHUNK_SIZE="0"
#               - 사용안함
#
# JID_CHUNK_RANDOMIZE
#         : JID_CHUNK_SIZE 분할 전 대상 목록 랜덤 셔플 여부
#           true/false, 기본값 true
#           false이면 정렬된 최종 server 목록 순서대로 분할합니다.
# ============================================================
SKIP_PING="true"
ASYNC="false"
COLLECT_BY_JID="true"
JOB_WAIT_TIMEOUT="300"


# ============================================================
make_server() {
    bash $base_dir/pre
}
