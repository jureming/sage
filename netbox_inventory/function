#!/usr/bin/env bash

# ==================================================================================================
# NetBox TSV inventory SQL-like query functions
#
# 사용:
#   source /data/salt/common/function_netbox/function
#
#   inventory -h
#   inventory "select name from vm where deploy_exception='false' and role='db_SRV' and name like 'm%'"
#   inventory "select distinct role from all"
#
# 지원 SQL-like 문법:
#   SELECT [DISTINCT] field[, field ...] FROM vm|device|all
#     [WHERE boolean_expression]
#
# 지원 조건 연산자:
#   =, !=, <>, LIKE, NOT LIKE, REGEXP, NOT REGEXP
#
# 주의:
#   - 실제 DB에 접속하지 않습니다. vm_inventory/device_inventory TSV 파일을 조회합니다.
#   - SQL 전체 문법이 아니라 운영 조회에 필요한 안전한 부분집합만 지원합니다.
#   - 비교는 기본적으로 대소문자를 구분하지 않습니다.
#   - 값에 공백이 있으면 전체 쿼리를 큰따옴표로 감싸고 값은 작은따옴표로 감쌉니다.
# ==================================================================================================

netbox_inventory_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
devices_file="${NETBOX_DEVICE_INVENTORY_FILE:-$netbox_inventory_dir/device_inventory}"
vm_file="${NETBOX_VM_INVENTORY_FILE:-$netbox_inventory_dir/vm_inventory}"

_inventory_error() {
    printf 'inventory: %s\n' "$*" >&2
}

inventory_help() {
    cat <<'HELP'
사용법:
  source /data/salt/common/function_netbox/function

고정 업무 함수:
  get_allservers             VM + Device 전체 서버명
  get_vm_allservers          VM 전체 서버명
  get_device_allservers      Device 전체 서버명
  get_mailservers            service_unit=webmail_SVC 전체 메일 서버
  get_valid_s_mailservers    통합 메일 서버
  get_valid_d_mailservers    단독 메일 서버
  get_valid_resellers        리셀러 전용 통합 메일 서버
  get_valid_mailservers      deploy_exception=false인 전체 메일 서버

  inventory -h
  inventory "SQL-like query"

기본 문법:
  SELECT [DISTINCT] field[, field ...]
  FROM vm|device|all
  [WHERE boolean_expression]

조회 대상(테이블):
  vm       vm_inventory만 조회
  device   device_inventory만 조회
  all      vm_inventory와 device_inventory 모두 조회

사용 가능한 컬럼:
  inventory_type
  name
  role
  zone
  platform
  service_unit
  ip_internal
  ip_external
  primary_ip4
  primary_ip6
  site
  cluster
  vm_zone
  backup_run
  backup_host
  deploy_exception
  template_name

지원 조건 연산자:
  =             정확히 일치
  !=, <>        불일치
  LIKE          SQL LIKE 패턴 일치
  NOT LIKE      SQL LIKE 패턴 불일치
  REGEXP        POSIX 확장 정규식 일치
  NOT REGEXP    POSIX 확장 정규식 불일치

LIKE 패턴:
  %             0개 이상의 임의 문자
  _             임의의 한 문자

기본 조회 예시:
  # 배포 예외가 아닌 DB Role의 m으로 시작하는 VM
  inventory "select name from vm where deploy_exception='false' and role='db_SRV' and name like 'm%'"

  # 여러 컬럼 출력
  inventory "select name, role, zone, ip_internal from vm where role='db_SRV'"

  # OR 조건
  inventory "select name from vm where role='db_SRV' or role='app_SRV'"

  # AND + OR + 괄호
  inventory "select name from vm where deploy_exception='false' and (role='db_SRV' or role='app_SRV')"

  # 등록된 전체 Role 목록
  inventory "select distinct role from all"

  # 등록된 VM Service Unit 목록
  inventory "select distinct service_unit from vm"

  # 특정 Zone의 Role 목록
  inventory "select distinct role from vm where zone='prod-corp'"

  # 정규식 조건
  inventory "select name from vm where name regexp '^m[a-f][0-9]+$'"

  # 모든 컬럼 출력
  inventory "select * from vm where name='ma1'"

  # 값에 공백이 있는 조회
  inventory "select name from vm where platform='Rocky 8.10'"

조건 결합:
  AND           모든 조건이 참
  OR            하나 이상의 조건이 참
  ( ... )       조건 우선순위 지정

조건 우선순위:
  괄호 > AND > OR

제한사항:
  - JOIN, GROUP BY, HAVING, 서브쿼리, INSERT, UPDATE, DELETE는 지원하지 않습니다.
  - 조회 결과는 기본적으로 컬럼 값 기준으로 정렬됩니다.
HELP
}

inventory() {
    local query

    case "${1:-}" in
        -h|--help)
            inventory_help
            return 0
            ;;
    esac

    if (($# == 0)); then
        _inventory_error "조회문이 필요합니다. inventory -h로 사용법을 확인하세요."
        return 2
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        _inventory_error "python3 명령을 찾을 수 없습니다."
        return 127
    fi

    # 전체 쿼리를 한 인자로 전달하는 방식을 권장하지만,
    # 공백 없는 값만 사용하는 경우 여러 인자로 입력해도 동작하도록 합칩니다.
    query="$*"

    python3 - "$query" "$vm_file" "$devices_file" <<'PY'
from __future__ import annotations

import csv
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Sequence


VM_FIELDS: tuple[str, ...] = (
    "name",
    "role",
    "zone",
    "platform",
    "service_unit",
    "ip_internal",
    "ip_external",
    "primary_ip4",
    "primary_ip6",
    "site",
    "cluster",
    "vm_zone",
    "backup_run",
    "backup_host",
    "deploy_exception",
    "template_name",
)

DEVICE_FIELDS: tuple[str, ...] = (
    "name",
    "role",
    "platform",
    "ip_internal",
    "ip_external",
    "primary_ip4",
    "primary_ip6",
    "site",
)

ALL_FIELDS: tuple[str, ...] = (
    "inventory_type",
    "name",
    "role",
    "zone",
    "platform",
    "service_unit",
    "ip_internal",
    "ip_external",
    "primary_ip4",
    "primary_ip6",
    "site",
    "cluster",
    "vm_zone",
    "backup_run",
    "backup_host",
    "deploy_exception",
    "template_name",
)

FIELD_SET = set(ALL_FIELDS)


class QueryError(ValueError):
    pass


@dataclass(frozen=True)
class Condition:
    field: str
    operator: str
    value: str


@dataclass(frozen=True)
class AndExpression:
    expressions: tuple["BooleanExpression", ...]


@dataclass(frozen=True)
class OrExpression:
    expressions: tuple["BooleanExpression", ...]


BooleanExpression = Condition | AndExpression | OrExpression


@dataclass(frozen=True)
class Query:
    fields: tuple[str, ...]
    source: str
    distinct: bool
    where_expression: BooleanExpression | None


def fail(message: str, exit_code: int = 2) -> None:
    print(f"inventory: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def strip_optional_semicolon(query: str) -> str:
    query = query.strip()
    if query.endswith(";"):
        query = query[:-1].rstrip()
    return query


def split_top_level(text: str, keyword: str) -> list[str]:
    """Split on a standalone keyword outside quotes and parentheses."""
    parts: list[str] = []
    start = 0
    index = 0
    quote: str | None = None
    depth = 0
    keyword_lower = keyword.lower()
    keyword_length = len(keyword)

    while index < len(text):
        char = text[index]

        if quote is not None:
            if char == quote:
                # SQL doubled quote: 'it''s'
                if index + 1 < len(text) and text[index + 1] == quote:
                    index += 2
                    continue
                quote = None
            elif char == "\\" and index + 1 < len(text):
                index += 2
                continue
            index += 1
            continue

        if char in ("'", '"'):
            quote = char
            index += 1
            continue

        if char == "(":
            depth += 1
            index += 1
            continue

        if char == ")":
            depth -= 1
            if depth < 0:
                raise QueryError("닫는 괄호가 너무 많습니다.")
            index += 1
            continue

        if depth == 0:
            candidate = text[index:index + keyword_length]
            if candidate.lower() == keyword_lower:
                before = text[index - 1] if index > 0 else " "
                after_index = index + keyword_length
                after = text[after_index] if after_index < len(text) else " "
                if not (before.isalnum() or before == "_") and not (after.isalnum() or after == "_"):
                    parts.append(text[start:index].strip())
                    start = after_index
                    index = after_index
                    continue

        index += 1

    if quote is not None:
        raise QueryError("따옴표가 닫히지 않았습니다.")
    if depth > 0:
        raise QueryError("여는 괄호가 닫히지 않았습니다.")

    parts.append(text[start:].strip())
    return parts


def outer_parentheses_wrap_entire_expression(text: str) -> bool:
    text = text.strip()
    if len(text) < 2 or text[0] != "(" or text[-1] != ")":
        return False

    quote: str | None = None
    depth = 0
    index = 0

    while index < len(text):
        char = text[index]

        if quote is not None:
            if char == quote:
                if index + 1 < len(text) and text[index + 1] == quote:
                    index += 2
                    continue
                quote = None
            elif char == "\\" and index + 1 < len(text):
                index += 2
                continue
            index += 1
            continue

        if char in ("'", '"'):
            quote = char
        elif char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
            if depth < 0:
                raise QueryError("닫는 괄호가 너무 많습니다.")
            if depth == 0 and index != len(text) - 1:
                return False
        index += 1

    if quote is not None:
        raise QueryError("따옴표가 닫히지 않았습니다.")
    if depth != 0:
        raise QueryError("괄호가 올바르게 닫히지 않았습니다.")
    return True


def strip_wrapping_parentheses(text: str) -> str:
    expression = text.strip()
    while outer_parentheses_wrap_entire_expression(expression):
        expression = expression[1:-1].strip()
    return expression


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        quote = value[0]
        body = value[1:-1]
        body = body.replace(quote * 2, quote)
        body = body.replace("\\" + quote, quote)
        body = body.replace("\\\\", "\\")
        return body
    return value


def sql_like_to_regex(pattern: str) -> str:
    result: list[str] = ["^"]
    index = 0

    while index < len(pattern):
        char = pattern[index]
        if char == "\\" and index + 1 < len(pattern):
            index += 1
            result.append(re.escape(pattern[index]))
        elif char == "%":
            result.append(".*")
        elif char == "_":
            result.append(".")
        else:
            result.append(re.escape(char))
        index += 1

    result.append("$")
    return "".join(result)


def parse_condition(expression: str) -> Condition:
    condition_pattern = re.compile(
        r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*"
        r"(NOT\s+REGEXP|NOT\s+LIKE|REGEXP|LIKE|!=|<>|=)\s*"
        r"(.+?)\s*$",
        re.IGNORECASE,
    )
    match = condition_pattern.match(expression)
    if not match:
        raise QueryError(f"지원하지 않는 WHERE 조건입니다: {expression}")

    field = match.group(1).lower()
    operator = re.sub(r"\s+", " ", match.group(2).upper())
    value = unquote(match.group(3))

    if field not in FIELD_SET:
        raise QueryError(f"존재하지 않는 조건 컬럼입니다: {field}")

    if operator in {"LIKE", "NOT LIKE"}:
        value = sql_like_to_regex(value)

    return Condition(field=field, operator=operator, value=value)


def parse_boolean_expression(expression: str) -> BooleanExpression:
    expression = strip_wrapping_parentheses(expression)
    if not expression:
        raise QueryError("WHERE 조건이 비어 있습니다.")

    # SQL 우선순위: 괄호 > AND > OR
    or_parts = split_top_level(expression, "or")
    if len(or_parts) > 1:
        if any(not part for part in or_parts):
            raise QueryError("WHERE의 OR 앞뒤에 조건이 필요합니다.")
        return OrExpression(tuple(parse_boolean_expression(part) for part in or_parts))

    and_parts = split_top_level(expression, "and")
    if len(and_parts) > 1:
        if any(not part for part in and_parts):
            raise QueryError("WHERE의 AND 앞뒤에 조건이 필요합니다.")
        return AndExpression(tuple(parse_boolean_expression(part) for part in and_parts))

    return parse_condition(expression)


def parse_query(raw_query: str) -> Query:
    query = strip_optional_semicolon(raw_query)
    select_pattern = re.compile(
        r"^\s*SELECT\s+(?:(DISTINCT)\s+)?(.+?)\s+FROM\s+(vm|device|all)"
        r"(?:\s+WHERE\s+(.+))?\s*$",
        re.IGNORECASE | re.DOTALL,
    )
    match = select_pattern.match(query)
    if not match:
        raise QueryError(
            "문법이 올바르지 않습니다. "
            "예: select name from vm where role='db_SRV'"
        )

    distinct = bool(match.group(1))
    select_clause = match.group(2).strip()
    source = match.group(3).lower()
    where_clause = match.group(4)

    if select_clause == "*":
        fields = ALL_FIELDS
    else:
        fields = tuple(field.strip().lower() for field in select_clause.split(","))
        if not fields or any(not field for field in fields):
            raise QueryError("SELECT 출력 컬럼이 비어 있습니다.")
        for field in fields:
            if field not in FIELD_SET:
                raise QueryError(f"존재하지 않는 출력 컬럼입니다: {field}")

    where_expression: BooleanExpression | None = None
    if where_clause is not None:
        where_expression = parse_boolean_expression(where_clause)

    return Query(
        fields=fields,
        source=source,
        distinct=distinct,
        where_expression=where_expression,
    )


def row_from_vm(values: Sequence[str]) -> dict[str, str]:
    row = {field: "" for field in ALL_FIELDS}
    row["inventory_type"] = "vm"
    for index, field in enumerate(VM_FIELDS):
        if index < len(values):
            row[field] = values[index].rstrip("\r")
    return row


def row_from_device(values: Sequence[str]) -> dict[str, str]:
    row = {field: "" for field in ALL_FIELDS}
    row["inventory_type"] = "device"
    for index, field in enumerate(DEVICE_FIELDS):
        if index < len(values):
            row[field] = values[index].rstrip("\r")
    return row


def read_tsv(path: Path, inventory_type: str) -> Iterable[dict[str, str]]:
    if not path.is_file():
        return

    with path.open("r", encoding="utf-8", errors="replace", newline="") as handle:
        reader = csv.reader(handle, delimiter="\t")
        for values in reader:
            if not values or all(value == "" for value in values):
                continue
            if inventory_type == "vm":
                yield row_from_vm(values)
            else:
                yield row_from_device(values)


def regex_matches(actual: str, pattern: str) -> bool:
    try:
        return re.search(pattern, actual, flags=re.IGNORECASE) is not None
    except re.error as exc:
        raise QueryError(f"정규식이 올바르지 않습니다: {pattern}: {exc}") from exc


def condition_matches(row: dict[str, str], condition: Condition) -> bool:
    actual = row.get(condition.field, "")
    expected = condition.value
    operator = condition.operator

    if operator == "=":
        return actual.casefold() == expected.casefold()
    if operator in {"!=", "<>"}:
        return actual.casefold() != expected.casefold()
    if operator in {"LIKE", "REGEXP"}:
        return regex_matches(actual, expected)
    if operator in {"NOT LIKE", "NOT REGEXP"}:
        return not regex_matches(actual, expected)

    raise QueryError(f"지원하지 않는 연산자입니다: {operator}")


def expression_matches(row: dict[str, str], expression: BooleanExpression) -> bool:
    if isinstance(expression, Condition):
        return condition_matches(row, expression)
    if isinstance(expression, AndExpression):
        return all(expression_matches(row, item) for item in expression.expressions)
    if isinstance(expression, OrExpression):
        return any(expression_matches(row, item) for item in expression.expressions)
    raise QueryError("지원하지 않는 조건식입니다.")


def execute(query: Query, vm_path: Path, device_path: Path) -> list[tuple[str, ...]]:
    rows: list[dict[str, str]] = []

    if query.source in {"vm", "all"}:
        rows.extend(read_tsv(vm_path, "vm") or ())
    if query.source in {"device", "all"}:
        rows.extend(read_tsv(device_path, "device") or ())

    if not rows:
        checked: list[str] = []
        if query.source in {"vm", "all"}:
            checked.append(f"VM: {vm_path}")
        if query.source in {"device", "all"}:
            checked.append(f"Device: {device_path}")
        raise QueryError("조회할 inventory 데이터가 없습니다. " + ", ".join(checked))

    result: list[tuple[str, ...]] = []
    seen: set[tuple[str, ...]] = set()

    for row in rows:
        if query.where_expression is not None and not expression_matches(row, query.where_expression):
            continue

        selected = tuple(row[field] for field in query.fields)
        if query.distinct:
            if selected in seen:
                continue
            seen.add(selected)
        result.append(selected)

    result.sort(key=lambda values: tuple(value.casefold() for value in values))
    return result


def main() -> int:
    if len(sys.argv) != 4:
        fail("내부 인자 오류입니다.", 2)

    raw_query = sys.argv[1]
    vm_path = Path(sys.argv[2])
    device_path = Path(sys.argv[3])

    try:
        parsed = parse_query(raw_query)
        result = execute(parsed, vm_path, device_path)
    except QueryError as exc:
        fail(str(exc), 2)

    writer = csv.writer(sys.stdout, delimiter="\t", lineterminator="\n")
    writer.writerows(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PY
}

