#!/usr/bin/env bash

# vm_inventory 출력 순서
# 이름  Role  Zone  OS버전  Service-unit  외부망  내부망  Primary IPv4  Primary IPv6
#
# device_inventory 출력 순서
# 이름  Role  OS버전  외부망  내부망  Primary IPv4  Primary IPv6

netbox_inventory_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
devices_file="$netbox_inventory_dir/device_inventory"
vm_file="$netbox_inventory_dir/vm_inventory"

host_name="$(hostname -s 2>/dev/null || hostname)"
host_name="${host_name%%.*}"

# hostname별 VM Zone
case "$host_name" in
    master-demo)
        zones=("demo-corp")
        ;;

    master-dev)
        zones=("devs-corp")
        ;;

    salt01|salt02)
        zones=("prod-corp" "prod-resl")
        ;;

    zmaster901)
        zones=("prod-ncrt")
        ;;

    zmaster-test2)
        zones=("test-cert")
        ;;

    master-test)
        zones=("test-corp")
        ;;

    zmaster101)
        zones=("prod-cert")
        ;;

    *)
        echo "Zone 매핑이 없는 서버: $host_name" >&2
        exit 1
        ;;
esac

# 해당 Zone 전체 서버
get_allservers() {
    local zone

    {
        if [[ -f "$vm_file" ]]; then
            for zone in "${zones[@]}"; do
                awk -F '\t' -v value="$zone" '
                    tolower($3) == tolower(value) {
                        print $1
                    }
                ' "$vm_file"
            done
        fi

        if [[ "$host_name" == "salt01" || "$host_name" == "salt02" ]]; then
            if [[ -f "$devices_file" ]]; then
                cut -f1 "$devices_file"
            fi
        fi
    } | sort -u
}

# 해당 Zone 전체 VM 서버
get_vm_allservers() {
    local zone

    {
        if [[ -f "$vm_file" ]]; then
            for zone in "${zones[@]}"; do
                awk -F '\t' -v value="$zone" '
                    tolower($3) == tolower(value) {
                        print $1
                    }
                ' "$vm_file"
            done
        fi
    } | sort -u
}

# 전체 Device 서버
get_device_allservers() {
    if [[ -f "$devices_file" ]]; then
        cut -f1 "$devices_file" | sort -u
    fi
}

# Zone 구분 없는 전체 서버
get_real_allservers() {
    {
        if [[ -f "$devices_file" ]]; then
            cut -f1 "$devices_file"
        fi

        if [[ -f "$vm_file" ]]; then
            cut -f1 "$vm_file"
        fi
    } | sort -u
}

# 전체 메일 서버
get_mailservers() {
    {
        if [[ -f "$vm_file" ]]; then
            awk -F '\t' '
                tolower($5) == "webmail_svc" {
                    print $1
                }
            ' "$vm_file"
        fi

        echo "m10"
    } | sort -u
}

# 단독 메일 서버
get_valid_d_mailservers() {
    if [[ -f "$vm_file" ]]; then
        awk -F '\t' '
            tolower($5) == "webmail_svc" &&
            tolower($1) ~ /^m[0-9]+$/ &&
            tolower($1) != "m10" {
                print $1
            }
        ' "$vm_file" | sort -u
    fi
}

# 통합 메일 서버
get_valid_s_mailservers() {
    {
        if [[ -f "$vm_file" ]]; then
            awk -F '\t' '
                tolower($5) == "webmail_svc" &&
                tolower($1) ~ /^m[a-f][0-9]+$/ {
                    print $1
                }
            ' "$vm_file"
        fi

        echo "m10"
    } | sort -u
}

# 리셀러 전용 메일 서버
get_valid_resellers() {
    if [[ -f "$vm_file" ]]; then
        awk -F '\t' '
            tolower($5) == "webmail_svc" &&
            tolower($3) == "prod-resl" &&
            tolower($1) ~ /^m[a-f][0-9]+$/ {
                print $1
            }
        ' "$vm_file" | sort -u
    fi
}

# 해당 Zone 전체 서버에서 메일 서버 제외
get_non_mailservers() {
    comm -23 \
        <(get_allservers | sort -u) \
        <(get_mailservers | sort -u)
}

# OS별 서버 조회
#
# VM:
#   4번째 컬럼 = OS
#
# Device:
#   3번째 컬럼 = OS
#
# 사용:
#   get_os_servers "Rocky 8.10"
#   get_os_servers "Ubuntu 22.04"
get_os_servers() {
    local os="${1:?OS를 입력하세요}"

    {
        if [[ -f "$vm_file" ]]; then
            awk -F '\t' -v value="$os" '
                tolower($4) == tolower(value) {
                    print $1
                }
            ' "$vm_file"
        fi

        if [[ -f "$devices_file" ]]; then
            awk -F '\t' -v value="$os" '
                tolower($3) == tolower(value) {
                    print $1
                }
            ' "$devices_file"
        fi
    } | sort -u
}

# Service-unit 기준
#
# VM:
#   5번째 컬럼 = Service-unit
#
# 사용:
#   get_service_unit_servers "webmail_SVC"
#   get_service_unit_servers "N/A"
get_service_unit_servers() {
    local service_unit="${1:?Service-unit을 입력하세요}"

    {
        if [[ -f "$vm_file" ]]; then
            awk -F '\t' -v value="$service_unit" '
                tolower($5) == tolower(value) {
                    print $1
                }
            ' "$vm_file"
        fi

        if [[ "${service_unit,,}" == "webmail_svc" ]]; then
            echo "m10"
        fi
    } | sort -u
}

# Role 기준
#
# VM과 Device:
#   2번째 컬럼 = Role
#
# 사용:
#   get_role_servers "db_SRV"
#   get_role_servers "Hypervisor"
#   get_role_servers "Switch"
get_role_servers() {
    local role="${1:?Role을 입력하세요}"

    {
        if [[ -f "$vm_file" ]]; then
            awk -F '\t' -v value="$role" '
                tolower($2) == tolower(value) {
                    print $1
                }
            ' "$vm_file"
        fi

        if [[ -f "$devices_file" ]]; then
            awk -F '\t' -v value="$role" '
                tolower($2) == tolower(value) {
                    print $1
                }
            ' "$devices_file"
        fi
    } | sort -u
}

